{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public && cp index.html script.js styles.css public/",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "schema.sql"
    }
  }
}